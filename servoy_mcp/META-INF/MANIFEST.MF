Import-Package: com.fasterxml.jackson.databind,
 jakarta.servlet;version="[6.1.0,8.0.0)",
 jakarta.servlet.http;version="[6.1.0,8.0.0)",
 org.slf4j;version="2.0.17"
Automatic-Module-Name: servoy_mcp
