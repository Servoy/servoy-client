<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<prerequisites>
		<maven>3.9.0</maven>
	</prerequisites>
	<artifactId>servoy-client</artifactId>
	<version>2026.12.0-SNAPSHOT</version>
	<groupId>com.servoy</groupId>
	<packaging>pom</packaging>

	<properties>
		<tycho.version>5.0.3</tycho.version>
		<jacoco.version>0.8.12</jacoco.version>
		<rhino.version>1.9.1.s5</rhino.version>
        <osgi.version>[2026.12.0,2026.12.1)</osgi.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
	</properties>

	<repositories>
		<repository>
			<id>developer_repo</id>
			<name>developer_repo</name>
			<url>https://developer.servoy.com/mvn_repository/</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>tycho-snapshots</id>
			<url>https://repo.eclipse.org/content/repositories/tycho-snapshots/</url>
		</pluginRepository>
	</pluginRepositories>

     <distributionManagement>
        <repository>
            <id>my-s3-release-repo</id>
            <url>file://C:/m2-repo/</url>
        </repository>
    </distributionManagement>

	<profiles>
		<profile>
			<id>doc</id>
			<modules>
				<module>servoy_doc</module>
			</modules>
		</profile>
		<profile>
			<id>design_doc</id>
			<modules>
				<module>servoy_doc</module>
			</modules>
		</profile>
		<profile>
			<id>plugins</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<modules>
				<module>servoy_base</module>
				<module>servoy_shared</module>
				<module>servoy_smart_client</module>
				<module>servoy_headless_client</module>
				<module>servoy_ngclient</module>
				<module>servoy_mcp</module>
				<module>servoy_mcp_tests</module>
				<module>servoy_ngclient.tests</module>
				<module>servoy_debug</module>
			</modules>
		</profile>
		<!-- JaCoCo report step, run after a build that executed the tests (target/jacoco.exec in each test module):
		       mvn -Pplugins,coverage-report org.jacoco:jacoco-maven-plugin:merge org.jacoco:jacoco-maven-plugin:report \
		           -pl servoy_base,servoy_shared,servoy_smart_client,servoy_headless_client,servoy_ngclient,servoy_mcp,servoy_debug
		     (-Pplugins is required: activating any profile of this pom deactivates the activeByDefault one.)
		     In every production bundle, 'merge' unions the exec files of ALL test modules into
		     target/jacoco-merged.exec (a test of one bundle often exercises classes of another; data for other
		     bundles' classes is ignored by that bundle's report), then 'report' analyzes the bundle's own
		     target/classes + sources and writes target/site/jacoco/jacoco.xml, which Jenkins' recordCoverage
		     (JACOCO) aggregates. One plugin-level configuration serves both direct goals: 'merge' reads
		     fileSets/destFile, 'report' reads dataFile. Missing exec files are skipped. -->
		<profile>
			<id>coverage-report</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>${jacoco.version}</version>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${project.basedir}/..</directory>
									<includes>
										<include>*.tests/target/jacoco.exec</include>
										<include>*_tests/target/jacoco.exec</include>
									</includes>
								</fileSet>
							</fileSets>
							<destFile>${project.build.directory}/jacoco-merged.exec</destFile>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
							<outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
							<!-- 'report' only: do not analyze archives that end up in target/classes (bundled libs) -->
							<excludes>
								<exclude>**/*.jar</exclude>
								<exclude>**/*.war</exclude>
								<exclude>**/*.zip</exclude>
							</excludes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
        <profile>
            <id>version_push</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>1.8</version>
                        <executions>
                            <execution>
                                <id>replace_version_in_property_files</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                         <replace
                                            file="${basedir}/pom.xml"
                                            token="${osgi.version}" value="${newOSGIVersion}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
	</profiles>


	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho.version}</version>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-compiler-plugin</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<compilerArgument>-warn:none</compilerArgument>
					<useProjectSettings>false</useProjectSettings>
					<useJDK>BREE</useJDK>
					<deriveReleaseCompilerArgumentFromTargetLevel>false</deriveReleaseCompilerArgumentFromTargetLevel>
					<extraClasspathElements>
						<dependency>
							<groupId>javax.jnlp</groupId>
							<artifactId>jnlp-api</artifactId>
							<version>8.0</version>
						</dependency>
					</extraClasspathElements>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<executionEnvironment>JavaSE-21</executionEnvironment>
					<target>
						<artifact>
							<groupId>com.servoy</groupId>
							<artifactId>com.servoy.eclipse.target</artifactId>
							<version>${project.version}</version>
						</artifact>
					</target>
					<pomDependencies>consider</pomDependencies>
					<environments>
						<environment>
							<os>win32</os>
							<ws>win32</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>macosx</os>
							<ws>cocoa</ws>
							<arch>x86_64</arch>
						</environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>aarch64</arch>
                        </environment>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
					</environments>
					<dependency-resolution>
						<optionalDependencies>ignore</optionalDependencies>
					</dependency-resolution>
					<filters>
						<filter>
							<type>eclipse-plugin</type>
							<id>sablo</id>
							<restrictTo>
								<versionRange>${osgi.version}</versionRange>
							</restrictTo>
						</filter>
						<filter>
							<type>eclipse-plugin</type>
							<id>org.eclipse.dltk.javascript.rhino</id>
							<restrictTo>
								<version>${rhino.version}</version>
							</restrictTo>
						</filter>
						<filter>
							<type>eclipse-plugin</type>
							<id>servoy_base</id>
							<restrictTo>
								<versionRange>${osgi.version}</versionRange>
							</restrictTo>
						</filter>
						<filter>
							<type>eclipse-plugin</type>
							<id>servoy_ngclient</id>
							<restrictTo>
								<versionRange>${osgi.version}</versionRange>
							</restrictTo>
						</filter>
						<filter>
							<type>eclipse-plugin</type>
							<id>servoy_shared</id>
							<restrictTo>
								<versionRange>${osgi.version}</versionRange>
							</restrictTo>
						</filter>
						<filter>
							<type>eclipse-plugin</type>
							<id>servoy_headless_client</id>
							<restrictTo>
								<versionRange>${osgi.version}</versionRange>
							</restrictTo>
						</filter>
						<filter>
							<type>eclipse-plugin</type>
							<id>servoy_smart_client</id>
							<restrictTo>
								<versionRange>${osgi.version}</versionRange>
							</restrictTo>
						</filter>
					</filters>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-versions-plugin</artifactId>
				<version>${tycho.version}</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jarsigner-plugin</artifactId>
				<version>3.0.0.s1</version>
				<executions>
					<execution>
						<id>sign</id>
						<goals>
							<goal>sign</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-plugin</artifactId>
				<version>${tycho.version}</version>
				<executions>
					<execution>
						<id>p2-metadata</id>
						<goals>
							<goal>p2-metadata</goal>
						</goals>
						<phase>package</phase>
					</execution>
				</executions>
				<configuration>
					<defaultP2Metadata>false</defaultP2Metadata>
				</configuration>
			</plugin>
			<!-- JaCoCo code coverage for the Java tests (same recipe as servoy-eclipse).
			     The test modules here (servoy_ngclient.tests, servoy_mcp_tests) run through tycho-surefire. For an
			     eclipse-test-plugin, prepare-agent sets the tycho.testArgLine property, which tycho-surefire adds to the
			     test JVM by itself, so the agent writes target/jacoco.exec without any change in the test poms.
			     In the production modules it only sets an unused argLine property, so it is harmless there.
			     The report is NOT generated here: the classes exercised by a test module belong to the production
			     bundles, and the report goal only analyzes the current module's own classes. See the
			     coverage-report profile. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
